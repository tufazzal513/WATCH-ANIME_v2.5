# MoveX backend: every setting is an environment variable. Copy to .env (never commit it).

# ---- General ----
ROLE=main                      # main (default) or worker
PORT=3000                      # hosting platforms usually set this themselves
DATA_DIR=./data                # movex.db, telegram.session, session.key live here (use a persistent disk)

# ---- Firebase (Auth only) ----
FIREBASE_PROJECT_ID=           # required: used to verify user ID tokens
FIREBASE_API_KEY=              # main only, required: admin login + password reset
ADMIN_UIDS=                    # main only, required: comma-separated Firebase UIDs allowed into /admin

# ---- Web / security ----
ALLOWED_ORIGINS=https://yourname.github.io   # comma-separated frontend addresses, no path. "*" = any site (not for production)
TRUST_PROXY=0                  # 1 when behind a reverse proxy / platform router (use X-Forwarded-For)
COOKIE_SECURE=1                # keep 1 in production; 0 only for local http development
SESSION_SECRET=                # optional (32+ chars). Empty = random key auto-created in DATA_DIR/session.key

# ---- Backup to Telegram (main only; leave all three empty to disable) ----
BACKUP_EVERY_HOURS=12
TG_API_ID=
TG_API_HASH=
TG_CHAT_ID=                    # -100xxxxxxxxxx (account must have joined it) or @channelname
# The Telegram user account must be allowed to post and pin messages in the target chat.
TG_KEEP=30                     # backups kept in the channel

# ---- Worker only (ROLE=worker) ----
MAIN_URL=                      # e.g. https://main.example.com
WORKER_KEY=                    # shown once when you add this worker in the main admin panel
SYNC_NOTIFY_KEY=                # optional shared random secret (32+ chars), same on main and every worker; enables fast push notifications
PUBLIC_URL=                    # this worker's own public address
SYNC_EVERY_SEC=60

# ---- Tests only ----
DEV_INSECURE_AUTH=0            # 1 accepts "dev:<uid>" tokens; refused to start while COOKIE_SECURE=1
