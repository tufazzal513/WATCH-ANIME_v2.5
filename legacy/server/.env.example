# Copy to ".env" (or set the same values in the hosting panel). All optional except as noted.
PORT=3000
DB_PATH=./data/database.db
FIREBASE_PROJECT_ID=movex-513

# Your website address(es), comma separated. Example: https://movex.pages.dev,https://yourdomain.com
# "*" works but is less strict.
ALLOWED_ORIGINS=*

# Set to 1 when the host puts a proxy in front (so rate limits see the real visitor IP)
TRUST_PROXY=1

# Backups (local copy every N hours, keep the newest N files)
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_LOCAL=7

# Optional Google Drive backup (uses YOUR Drive's 15 GB). Leave empty to skip.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GDRIVE_KEEP_DAYS=30

# NEVER set this on the real server. Local tests only.
# DEV_INSECURE_AUTH=1

# ---------------- Roles ----------------
# main   = the only server that owns the real database (default)
# worker = read-replica: keeps a synced copy, answers reads fast, forwards writes to main
ROLE=main

# ---------------- Telegram backup (MAIN) ----------------
# 1) @BotFather -> new bot -> token   2) make a channel, add the bot as ADMIN (post + pin messages)
# 3) TG_CHAT_ID = -100xxxxxxxxxx (or @channelusername)
TG_BOT_TOKEN=
TG_CHAT_ID=
# BIG FILES (recommended): MTProto lifts the 20 MB bot-download limit (files up to ~2 GB).
# API ID + hash: https://my.telegram.org -> API development tools. Needs `npm install` (package "telegram").
# Either keep TG_BOT_TOKEN (then TG_CHAT_ID should be the channel @username), or log in once with `npm run tg-login`
# and put the printed session here (works with private channels / numeric -100... ids too).
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_KEEP=30
# BACKUP_EVERY_HOURS above also drives the Telegram upload (default here: 12)

# ---------------- Worker only ----------------
# MAIN_URL=https://your-main.botkeep.cloud
# WORKER_KEY=wk_...            (Admin panel -> Settings -> Servers -> Add worker)
# PUBLIC_URL=https://your-worker.botkeep.cloud   (so the website can find this worker)
# SYNC_EVERY_SEC=60   (only a safety check; the main server pushes changes instantly)
